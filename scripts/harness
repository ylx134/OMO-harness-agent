  fi

  echo -e "${BOLD}Archiving task ${task_id}...${NC}"

  node --input-type=module -e "
import { updateTaskStatus } from '$PLUGIN_DIR/dist/index.js';
const root = process.argv[1];
const taskId = process.argv[2];
try {
  const task = await updateTaskStatus(root, taskId, 'archived');
  if (!task) {
    console.error('ERROR: task not found:', taskId);
    process.exit(1);
  }
  console.log(JSON.stringify(task, null, 2));
} catch (err) {
  console.error('ERROR:', err.message);
  process.exit(1);
}
" -- "$HARNESS_BOARD_ROOT" "$task_id" 2>&1 || {
    echo ""
    echo -e "${RED}✗ Failed to archive task${NC}"
