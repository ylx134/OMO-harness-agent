  }

  echo ""
  echo -e "${GREEN}✓ Task archived${NC}"
  echo ""
}

# ─── Subcommand: start ───────────────────────────────────────────

cmd_start() {
  local task_title="${1:-}"
  if [[ -z "$task_title" ]]; then
    echo -e "${RED}ERROR: task title required${NC}"
    echo "Usage: hctl start <task description>"
    exit 1
  fi

  if [[ ! -f "$PLUGIN_DIR/dist/index.js" ]]; then
    echo -e "${RED}ERROR: Plugin dist not found at $PLUGIN_DIR/dist/index.js${NC}"
    echo "  Run ./setup.sh to build the plugin first."
    exit 1
  fi

  echo -e "${BOLD}Initializing harness task...${NC}"
  echo ""

  node --input-type=module -e "
import { initializeHarnessTask, classifyTask } from '$PLUGIN_DIR/dist/index.js';
const root = process.argv[1];
const title = process.argv[2];
const taskId = process.argv[3] || '';
try {
  const routeId = classifyTask(title);
  const state = await initializeHarnessTask(root, title, 'harness-orchestrator', routeId, true, taskId);
  console.log(JSON.stringify({
    routeId: state.routeId,
    taskType: state.taskType,
    flowTier: state.flowTier,
    currentPhase: state.currentPhase,
    nextExpectedActor: state.nextExpectedActor,
    managers: state.requiredManagers,
    hands: state.selectedCapabilityHands,
    probes: state.selectedProbes,
    requestId: state.requestId,
  }, null, 2));
} catch (err) {
  console.error('ERROR:', err.message);
  process.exit(1);
}
" -- "$HARNESS_BOARD_ROOT" "$task_title" "$(python3 -c "import uuid; print(str(uuid.uuid4())[:12])" 2>/dev/null || echo "manual-$$")" 2>&1 || {
    echo ""
    echo -e "${RED}✗ Failed to initialize task${NC}"
    exit 1
  }

  echo ""
  echo -e "${GREEN}✓ Harness task initialized${NC}"
  echo "  Inspect with: hctl status"
  echo ""
}

# ─── Subcommand: watch ────────────────────────────────────────────

cmd_watch() {
  local root
  root="$(find_workspace_root 2>/dev/null)" || true

  if [[ -z "$root" ]]; then
    echo -e "${RED}ERROR: No .agent-memory/ found${NC}"
    echo "  Start a harness task first with: hctl start <task>"
    exit 1
  fi

  local state_index="$root/.agent-memory/managed-agent-state-index.json"
  local activity="$root/.agent-memory/activity.jsonl"
  local last_activity_line=0
  local last_phase=""

  if [[ -f "$activity" ]]; then
    last_activity_line=$(wc -l < "$activity" | tr -d ' ')
  fi

  echo -e "${BOLD}Watching harness state...${NC} (Ctrl+C to stop)"
  echo ""

  while true; do
    # Check if state file changed
    if [[ -f "$state_index" ]]; then
      local current_phase route_id next_actor
      route_id="$(json_val "$state_index" 'route.route_id')"
      current_phase="$(json_val "$state_index" 'route.current_phase')"
      next_actor="$(json_val "$state_index" 'route.next_expected_actor')"

      if [[ "$current_phase" != "$last_phase" ]]; then
        local ts
        ts="$(date '+%H:%M:%S')"
        echo -e "  [${ts}] ${CYAN}Phase → ${current_phase}${NC}  Next: ${next_actor}"

        # Show blockers if any
        local blocked blocked_reason
        blocked="$(json_val "$state_index" 'route.blocked')"
        if [[ "$blocked" == "yes" ]]; then
          blocked_reason="$(json_val "$state_index" 'route.blocked_reason')"
          echo -e "         ${RED}BLOCKED: ${blocked_reason}${NC}"
        fi

        # Show dispatched
        local dispatched_hands dispatched_probes
        dispatched_hands="$(json_val "$state_index" 'dispatched_capability_hands')"
        dispatched_probes="$(json_val "$state_index" 'dispatched_probes')"
        if [[ "$dispatched_hands" != "none" ]]; then
          echo -e "         Hands: ${dispatched_hands}"
        fi
        if [[ "$dispatched_probes" != "none" ]]; then
          echo -e "         Probes: ${dispatched_probes}"
        fi

        last_phase="$current_phase"
      fi

      # Show new activity lines
      if [[ -f "$activity" ]]; then
        local current_lines
        current_lines=$(wc -l < "$activity" | tr -d ' ')
        if [[ $current_lines -gt $last_activity_line ]]; then
          local new_lines=$((current_lines - last_activity_line))
          tail -n "$new_lines" "$activity" 2>/dev/null | python3 -c "
import json, sys
for line in sys.stdin:
    line = line.strip()
    if not line: continue
    try:
        ev = json.loads(line)
        et = ev.get('event','?')
        ts = ev.get('ts','')[:19].replace('T',' ')
        label = {
            'task.intake': 'INTAKE',
            'route.selected': 'ROUTE',
            'manager.dispatch.requested': 'MGR_DISPATCH',
            'manager.completed': 'MGR_DONE',
            'capability.dispatch.requested': 'HAND_DISPATCH',
            'capability.completed': 'HAND_DONE',
            'probe.dispatch.requested': 'PROBE_DISPATCH',
            'probe.completed': 'PROBE_DONE',
            'route.completed': 'COMPLETE',
        }.get(et, et[:20])
        print(f'  [{ts}] {label}')
    except: pass
" 2>/dev/null || true
          last_activity_line=$current_lines
        fi
      fi
    fi

    # Check completion
    if [[ "$current_phase" == "complete" ]]; then
      echo ""
      echo -e "${GREEN}✓ Route complete${NC}"
      break
    fi

    sleep 1
  done
}

# ─── Subcommand: wake ─────────────────────────────────────────────

cmd_wake() {
  local root step_id=""
  root="$(find_workspace_root 2>/dev/null)" || true

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --step) step_id="$2"; shift 2 ;;
      *) shift ;;
    esac
  done

  if [[ -z "$root" ]]; then
    echo -e "${RED}ERROR: No .agent-memory/ found${NC}"
    exit 1
  fi

  local state_index="$root/.agent-memory/managed-agent-state-index.json"
  if [[ ! -f "$state_index" ]]; then
    echo -e "${RED}ERROR: No managed-agent-state-index.json found${NC}"
    exit 1
  fi

  echo -e "${BOLD}Waking harness route...${NC}"
  echo ""

  if [[ -n "$step_id" ]]; then
    echo -e "  Target step: ${CYAN}${step_id}${NC}"
  fi

  # Show current retryable state
  local retry_count
  retry_count="$(python3 -c "
import json, sys
with open('$state_index') as f:
    state = json.load(f)
step_runtime = state.get('stepRuntime', {})
retryable = {k: v.get('retryCount',0) for k,v in step_runtime.items() if v.get('status') == 'retryable_error'}
print(len(retryable))
" 2>/dev/null || echo "0")"

  if [[ "$retry_count" -gt 0 ]]; then
    echo -e "  ${YELLOW}${retry_count} step(s) in retryable error state${NC}"
  else
    echo -e "  ${GREEN}No steps in retryable error state${NC}"
  fi

  # Show blocked steps
  local blocked_steps
  blocked_steps="$(json_val "$state_index" 'graph_runtime.blocked_step_ids')"
  if [[ "$blocked_steps" != "none" ]] && [[ "$blocked_steps" != "N/A" ]] && [[ -n "$blocked_steps" ]]; then
    echo -e "  Blocked steps: ${RED}${blocked_steps}${NC}"
  fi

  # Attempt recovery via the plugin
  if [[ -f "$PLUGIN_DIR/dist/index.js" ]]; then
    echo ""
    echo -e "  ${DIM}Attempting graph runtime recovery...${NC}"
    node --input-type=module -e "
import { loadPluginState, recoverGraphRuntimeState, savePluginState } from '$PLUGIN_DIR/dist/index.js';
const root = process.argv[1];
try {
  const { state } = await loadPluginState(root);
  if (!state) {
    console.log('  No active harness state found');
    process.exit(0);
  }
  const recovered = recoverGraphRuntimeState(state);
  await savePluginState(root, recovered);
  const retryableSteps = Object.entries(recovered.stepRuntime || {}).filter(([,v]) => v.status === 'retryable_error');
  if (retryableSteps.length === 0) {
    console.log('  ✓ Graph runtime recovered — no remaining retryable errors');
  } else {
    console.log('  ⚠ Some steps still retryable:', retryableSteps.map(([k]) => k).join(', '));
  }
  const active = recovered.activeStepIds || [];
  const blocked = recovered.blockedStepIds || [];
  console.log('  Active steps:', active.join(', ') || 'none');
  console.log('  Blocked steps:', blocked.join(', ') || 'none');
} catch (err) {
  console.error('  ERROR:', err.message);
  process.exit(1);
}
" -- "$root" 2>&1 || {
    echo -e "  ${YELLOW}⚠ Recovery via plugin failed (may need running harness session)${NC}"
  }
  else
    echo -e "  ${YELLOW}⚠ Plugin dist not available for recovery${NC}"
  fi

  echo ""
}

# ─── Subcommand: step ─────────────────────────────────────────────

cmd_step() {
  local root
  root="$(find_workspace_root 2>/dev/null)" || true

  if [[ -z "$root" ]]; then
    echo -e "${RED}ERROR: No .agent-memory/ found${NC}"
    exit 1
  fi

  local state_index="$root/.agent-memory/managed-agent-state-index.json"
  if [[ ! -f "$state_index" ]]; then
    echo -e "${RED}ERROR: No state file found${NC}"
    exit 1
  fi

  echo -e "${BOLD}Advancing harness route...${NC}"
  echo ""

  # Show pre-step state
  local phase next_actor pending_hands pending_probes
  phase="$(json_val "$state_index" 'route.current_phase')"
  next_actor="$(json_val "$state_index" 'route.next_expected_actor')"
  pending_hands="$(json_val "$state_index" 'pending_capability_hands')"
  pending_probes="$(json_val "$state_index" 'pending_probes')"

  echo -e "  Before: phase=${CYAN}${phase}${NC}  next=${next_actor}"

  # Try to advance via plugin
  if [[ -f "$PLUGIN_DIR/dist/index.js" ]]; then
    node --input-type=module -e "
import { loadPluginState, savePluginState } from '$PLUGIN_DIR/dist/index.js';
const root = process.argv[1];
try {
  const { state } = await loadPluginState(root);
  if (!state) {
    console.log('No active harness state');
    process.exit(0);
  }
  // Force a dispatch attempt by clearing active dispatch if stuck
  if (state.activeDispatch && state.deferredDispatchState !== 'ready') {
    state.activeDispatch = null;
    state.deferredDispatchState = 'ready';
  }
  await savePluginState(root, state);
  console.log(JSON.stringify({
    phase: state.currentPhase,
    nextActor: state.nextExpectedActor,
    activeDispatch: state.activeDispatch?.actor || 'none',
    deferredState: state.deferredDispatchState,
  }, null, 2));
  const routeId = state.routeId || '?';
  console.log('Route: ' + routeId);
  console.log('');
  if (state.pendingManagers && state.pendingManagers.length > 0) {
    console.log('Next manager to dispatch: ' + state.pendingManagers[0]);
  } else if (state.pendingCapabilityHands && state.pendingCapabilityHands.length > 0) {
    console.log('Next hand to dispatch: ' + state.pendingCapabilityHands[0]);
  } else if (state.pendingProbes && state.pendingProbes.length > 0) {
    console.log('Next probe to dispatch: ' + state.pendingProbes[0]);
  } else if (state.currentPhase === 'complete') {
    console.log('Route complete — no further steps');
  } else {
    console.log('No pending actors — route may be blocked or complete');
  }
} catch (err) {
  console.error('ERROR:', err.message);
  process.exit(1);
}
" -- "$root" 2>&1 || {
    echo -e "  ${YELLOW}⚠ Step advance via plugin failed${NC}"
  }
  else
    echo -e "  ${YELLOW}⚠ Plugin dist not available${NC}"
  fi

  # Show post-step state
  if [[ -f "$state_index" ]]; then
    local new_phase new_next
    new_phase="$(json_val "$state_index" 'route.current_phase')"
    new_next="$(json_val "$state_index" 'route.next_expected_actor')"
    echo ""
    echo -e "  After:  phase=${CYAN}${new_phase}${NC}  next=${new_next}"
    if [[ "$new_phase" != "$phase" ]]; then
      echo -e "  ${GREEN}Phase changed: ${phase} → ${new_phase}${NC}"
    fi
  fi

  echo ""
}

# ─── Subcommand: inspect ──────────────────────────────────────────

cmd_inspect() {
  local target="${1:-}"
  if [[ -z "$target" ]]; then
    echo -e "${RED}ERROR: target file required${NC}"
    echo "Usage: hctl inspect <state-file>"
    echo ""
    echo "Common targets:"
    echo "  managed-agent-state-index.json"
    echo "  harness-plugin-state.json"
    echo "  route-packet.json"
    echo "  orchestration-status.md"
    echo "  acceptance-report.md"
    echo "  activity.jsonl (last 50 lines)"
    exit 1
  fi

  local root memory
  root="$(find_workspace_root 2>/dev/null)" || true

  if [[ -z "$root" ]]; then
    echo -e "${RED}ERROR: No .agent-memory/ found${NC}"
    exit 1
  fi

  memory="$root/.agent-memory"

  # Build absolute path if relative
  local full_path="$target"
  if [[ ! -f "$target" ]] && [[ -f "$memory/$target" ]]; then
    full_path="$memory/$target"
  fi
  if [[ ! -f "$full_path" ]]; then
    echo -e "${RED}ERROR: File not found: $target${NC}"
    echo "  Looked in: $target"
    echo "             $memory/$target"
    exit 1
  fi

  echo ""
  echo -e "${BOLD}╔══════════════════════════════════════════════════════╗${NC}"
  echo -e "${BOLD}║${NC}         ${CYAN}Harness Artifact Inspector${NC}                      ${BOLD}║${NC}"
  echo -e "${BOLD}╚══════════════════════════════════════════════════════╝${NC}"
  echo ""
  echo -e "${BOLD}File:${NC} ${DIM}${full_path}${NC}"

  local fsize
  fsize=$(wc -c < "$full_path" | tr -d ' ')
  echo -e "${BOLD}Size:${NC} ${fsize} bytes"

  local flines
  flines=$(wc -l < "$full_path" | tr -d ' ')
  echo -e "${BOLD}Lines:${NC} ${flines}"
  echo ""

  # Pretty-print based on file type
  if [[ "$target" == *".json" ]]; then
    echo -e "${BOLD}── JSON Content ──${NC}"
    python3 -c "
import json, sys
with open('$full_path') as f:
    data = json.load(f)
print(json.dumps(data, indent=2, ensure_ascii=False))
" 2>/dev/null || {
      echo -e "${YELLOW}(could not parse as JSON — showing raw content)${NC}"
      head -100 "$full_path"
      local remaining=$((flines - 100))
      if [[ $remaining -gt 0 ]]; then
        echo -e "  ${DIM}... and ${remaining} more lines${NC}"
      fi
    }
  elif [[ "$target" == *".jsonl" ]]; then
    local shown=50
    echo -e "${BOLD}── Last ${shown} Entries (JSONL) ──${NC}"
    tail -n "$shown" "$full_path" 2>/dev/null | python3 -c "
import json, sys
for i, line in enumerate(sys.stdin):
    line = line.strip()
    if not line: continue
    try:
        ev = json.loads(line)
        print(json.dumps(ev, ensure_ascii=False))
    except:
        print(line[:200])
" 2>/dev/null || tail -n "$shown" "$full_path"
    local remaining=$((flines - shown))
    if [[ $remaining -gt 0 ]]; then
      echo -e "  ${DIM}... and ${remaining} more lines${NC}"
    fi
  elif [[ "$target" == *".md" ]]; then
    echo -e "${BOLD}── Markdown Content ──${NC}"
    if [[ $flines -le 200 ]]; then
      cat "$full_path"
    else
      head -100 "$full_path"
      echo ""
      echo -e "  ${DIM}... (${flines} total lines, showing first 100)${NC}"
    fi
    echo ""

    # Extract headings
    echo -e "${BOLD}── Document Structure ──${NC}"
    grep '^#' "$full_path" 2>/dev/null | head -30 || echo "  (no headings found)"
  else
    echo -e "${BOLD}── Raw Content ──${NC}"
    head -100 "$full_path"
    local remaining=$((flines - 100))
    if [[ $remaining -gt 0 ]]; then
      echo -e "  ${DIM}... and ${remaining} more lines${NC}"
    fi
  fi

  echo ""
}

# ─── Subcommand: timeline ─────────────────────────────────────────

cmd_timeline() {
  local root
  root="$(find_workspace_root 2>/dev/null)" || true

  if [[ -z "$root" ]]; then
    echo -e "${RED}ERROR: No .agent-memory/ found${NC}"
    exit 1
  fi

  local activity="$root/.agent-memory/activity.jsonl"
  if [[ ! -f "$activity" ]]; then
    echo -e "${YELLOW}No activity.jsonl found at $activity${NC}"
    exit 0
  fi

  echo ""
  echo -e "${BOLD}╔══════════════════════════════════════════════════════╗${NC}"
  echo -e "${BOLD}║${NC}         ${CYAN}Harness Timeline${NC}                               ${BOLD}║${NC}"
  echo -e "${BOLD}╚══════════════════════════════════════════════════════╝${NC}"
  echo ""

  python3 -c "
import json, sys
from collections import defaultdict

events = []
with open('$activity') as f:
    for line in f:
        line = line.strip()
        if not line: continue
        try:
            events.append(json.loads(line))
        except: pass

if not events:
    print('  (no events recorded)')
    sys.exit(0)

# Phase transitions
phases = []
current_phase = None
for ev in events:
    et = ev.get('event','')
    if et == 'route.selected':
        current_phase = 'intake'
    elif et == 'manager.dispatch.requested':
        mgr = ev.get('manager','?')
        if mgr == 'planning-manager':
            current_phase = 'planning'
        elif mgr == 'execution-manager':
            current_phase = 'execution'
        elif mgr == 'acceptance-manager':
            current_phase = 'acceptance'
    elif et == 'route.completed':
        current_phase = 'complete'
    if current_phase:
        phases.append((ev.get('ts','')[:19], current_phase))

# Count by event type
counts = defaultdict(int)
for ev in events:
    counts[ev.get('event','?')] += 1

# Build timeline segments
segments = []
seg_start = None
seg_type = None
for ev in events:
    et = ev.get('event','')
    ts = ev.get('ts','')[:19].replace('T',' ')
    if et in ('task.intake', 'route.selected'):
        if seg_start:
            segments.append((seg_start, seg_type or 'active'))
        seg_start = ts
        seg_type = 'intake'
    elif et in ('manager.dispatch.requested', 'capability.dispatch.requested', 'probe.dispatch.requested'):
        if seg_type != 'dispatch':
            if seg_start:
                segments.append((seg_start, seg_type or 'active'))
            seg_start = ts
            seg_type = 'dispatch'
    elif et in ('manager.completed', 'capability.completed', 'probe.completed'):
        if seg_type != 'complete':
            if seg_start:
                segments.append((seg_start, seg_type or 'active'))
            seg_start = ts
            seg_type = 'complete'
    elif et == 'route.completed':
        if seg_start:
            segments.append((seg_start, seg_type or 'active'))
        segments.append((ts, 'done'))
        seg_start = None

if seg_start:
    segments.append((seg_start, seg_type or 'active'))

# Print summary
NC = '\033[0m'
CYAN = '\033[0;36m'
GREEN = '\033[0;32m'
YELLOW = '\033[1;33m'
RED = '\033[0;31m'
DIM = '\033[2m'
BOLD = '\033[1m'

print(f'{BOLD}Timeline Summary{NC}')
print()

if phases:
    print(f'{BOLD}Phase transitions:{NC}')
    import itertools
    unique_phases = [next(g) for _, g in itertools.groupby(phases, key=lambda x: x[1])]
    for ts, phase in unique_phases[:20]:
        color = {'intake': YELLOW, 'planning': CYAN, 'execution': GREEN, 'acceptance': CYAN, 'complete': GREEN}.get(phase, '')
        print(f'  [{ts}] {color}{phase}{NC}')

print()
print(f'{BOLD}Event counts:{NC}')
for etype, count in sorted(counts.items(), key=lambda x: -x[1])[:15]:
    print(f'  {etype:36s} {count:4d}')

print()
print(f'{BOLD}Timeline segments:{NC}')
seg_colors = {
    'intake': YELLOW,
    'dispatch': CYAN,
    'complete': GREEN,
    'done': GREEN,
    'active': DIM,
}
for seg in segments[:30]:
    ts, stype = seg
    color = seg_colors.get(stype, '')
    bar = '━' * min(len(stype) + 4, 20)
    print(f'  [{ts}] {color}{bar} {stype}{NC}')

# Duration
if len(events) >= 2:
    first_ts = events[0].get('ts','')
    last_ts = events[-1].get('ts','')
    try:
        from datetime import datetime
        t1 = datetime.fromisoformat(first_ts.replace('Z','+00:00'))
        t2 = datetime.fromisoformat(last_ts.replace('Z','+00:00'))
        delta = t2 - t1
        mins = int(delta.total_seconds() / 60)
        secs = int(delta.total_seconds() % 60)
        print()
        print(f'{BOLD}Duration:{NC} {mins}m {secs}s  ({len(events)} events)')
    except: pass

print()
" 2>/dev/null || {
    echo -e "${YELLOW}  (could not render timeline)${NC}"
  }
}

# ─── Main ────────────────────────────────────────────────────────

main() {
  local command="${1:-status}"
  shift 2>/dev/null || true

  case "$command" in
    status)        cmd_status "$@" ;;
    trace)         cmd_trace "$@" ;;
    blockers)      cmd_blockers "$@" ;;
    events)        cmd_events "$@" ;;
    summary)       cmd_summary "$@" ;;
    check)         cmd_check "$@" ;;
    task-create)   cmd_task_create "$@" ;;
    task-list)     cmd_task_list "$@" ;;
    task-resume)   cmd_task_resume "$@" ;;
    task-archive)  cmd_task_archive "$@" ;;
    start)         cmd_start "$@" ;;
    watch)         cmd_watch "$@" ;;
    wake)          cmd_wake "$@" ;;
    step)          cmd_step "$@" ;;
    inspect)       cmd_inspect "$@" ;;
    timeline)      cmd_timeline "$@" ;;
    help|--help|-h)
      echo "Usage: hctl <command> [options]"
      echo ""
      echo "Commands:"
      echo "  check               Verify if harness plugin is loaded"
      echo "  status              Show current route, phase, actors, and graph state"
      echo "  trace --round N     Show event timeline (optional: filter by round)"
      echo "  blockers            List all blocked steps, pending dispatch, and guardrails"
      echo "  events --last N     Show last N raw events from activity.jsonl"
      echo "  summary             One-line status for shell prompts"
      echo ""
      echo "Task Board:"
      echo "  task-create <title>  Create a new task on the task board"
      echo "  task-list            List all non-archived tasks"
      echo "  task-resume <taskId> Show task status details"
      echo "  task-archive <taskId> Archive a completed task"
      echo ""
      echo "Runner Commands:"
      echo "  start <task>         Initialize a new harness task/route"
      echo "  watch                Live monitor — poll for state changes"
      echo "  wake [--step <id>]   Resume paused or retryable steps"
      echo "  step                 Advance the route by one step"
      echo "  inspect <file>       Deep-inspect a state artifact"
      echo "  timeline             Rich timeline from activity.jsonl"
      echo ""
      echo "Environment:"
      echo "  WORKSPACE_ROOT              Override workspace directory (default: auto-detect)"
      echo "  OPENCODE_HARNESS_BOARD_ROOT  Task board storage root (default: ~/.opencode/harness-board)"
      ;;
    *)
      echo -e "${RED}Unknown command: $command${NC}"
      echo "Try 'hctl help' for usage."
      exit 1
      ;;
  esac
}

main "$@"
